# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=
NEXT_PUBLIC_DEFAULT_AGENT_NAME=my-agent
NEXT_PUBLIC_DYNAMIC_AGENT_NAME=dynamic-agent

# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
MONGODB_URI=
# Optional fallback URI without +srv to bypass SRV/TXT DNS lookups on hosts with flaky DNS.
# Example format:
# mongodb://username:password@host1:27017,host2:27017,host3:27017/dbname?ssl=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority
MONGODB_URI_FALLBACK=

# Token endpoint production hardening
# Comma-separated allowed origins (include scheme + host)
# Example: http://localhost:3000,https://your-app.onrender.com
TOKEN_ENDPOINT_ALLOWED_ORIGINS=
TOKEN_ENDPOINT_RATE_LIMIT=60
TOKEN_ENDPOINT_RATE_LIMIT_WINDOW_MS=60000
